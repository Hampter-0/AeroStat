DB_NAME=statuspage
DB_USER=statuspage
DB_PASSWORD=change_me
DATABASE_URL=postgres://statuspage:change_me@localhost:5432/statuspage

REDIS_URL=redis://localhost:6379

SQLX_OFFLINE=true

# 127.0.0.1 keeps the backend reachable only from this machine. Use
# 0.0.0.0 in Docker, where the port isn't published.
HOST=0.0.0.0
PORT=3004
RUST_LOG=info

METRICS_RETENTION_DAYS=60

# How long a panel sign-in lasts.
SESSION_DAYS=30

# Failed sign-ins before a block, and how long the block lasts.
LOGIN_MAX_FAILURES_PER_IP=10
LOGIN_MAX_FAILURES_PER_ACCOUNT=30
LOGIN_LOCKOUT_MINUTES=15
