# For development: the backend reads this as .env when you run it with cargo.
# Installing with Docker? Use deploy/.env.example instead.

# The dev Postgres and Redis from docker-compose.dev.yml.
DATABASE_URL=postgres://aerostat:aerostat@localhost:5432/aerostat

REDIS_URL=redis://localhost:6379

SQLX_OFFLINE=true

# 127.0.0.1 keeps the backend reachable only from this machine. Use
# 0.0.0.0 in Docker, where the port isn't published.
HOST=0.0.0.0
PORT=3004
RUST_LOG=info

METRICS_RETENTION_DAYS=60

# Show admins in the panel when a newer release is out.
UPDATE_CHECK=true

# Encrypts the authenticator app secrets for two-factor sign-in. Without it
# only email codes are offered. Make one with: openssl rand -hex 32
# Keep it safe: if it changes, everyone has to set up their app again.
SECRET_KEY=

# Email notifications. Leave SMTP_HOST empty to turn email off. Panel users
# choose on their profile which notifications they get. SMTP_ENCRYPTION is
# tls (port 465), starttls (port 587) or none.
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Defaults to the site name.
SMTP_FROM_NAME=

# How long a panel sign-in lasts.
SESSION_DAYS=30

# Failed sign-ins before a block, and how long the block lasts. The account
# limit only blocks IPs that never signed in to that account, so others
# can't lock you out.
LOGIN_MAX_FAILURES_PER_IP=10
LOGIN_MAX_FAILURES_PER_ACCOUNT=30
LOGIN_LOCKOUT_MINUTES=15

# Backups go to BACKUP_DIR (default /data/backups, the volume in Docker). The
# Docker image has pg_dump, pg_restore and psql; outside Docker, install the
# PostgreSQL client or point these at the tools.
#BACKUP_DIR=./backups
#PG_DUMP_PATH=pg_dump
#PG_RESTORE_PATH=pg_restore
#PSQL_PATH=psql
