# Copy this file to .env next to docker-compose.yml and fill it in.

# Image tag to run. "latest" or a version like "1.0.0".
AEROSTAT_VERSION=latest

# Where the status page is reachable. Use AEROSTAT_BIND=127.0.0.1 when a
# reverse proxy on the same server sits in front of it.
AEROSTAT_BIND=0.0.0.0
AEROSTAT_PORT=3000

# Required. Generate one with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Defaults for the panel settings. You can change these later in /manage.
SITE_NAME=AeroStat
CONTACT_URL=
PRIMARY_COLOR=#1678c2

# Database.
# Starts the Postgres that comes with AeroStat, so plain "docker compose up -d"
# and "docker compose pull" include it. Leave it empty when you use your own
# Postgres.
COMPOSE_PROFILES=postgres
# Bundled Postgres:
DB_USER=aerostat
DB_PASSWORD=change_me
DB_NAME=aerostat
DATABASE_URL=postgres://aerostat:change_me@postgres:5432/aerostat
# Your own Postgres on this server instead:
# DATABASE_URL=postgres://user:password@host.docker.internal:5432/aerostat

# How many days of check results to keep.
METRICS_RETENTION_DAYS=60

# How long a panel sign-in lasts.
SESSION_DAYS=30

# Failed sign-ins before a block, and how long the block lasts. The account
# limit only blocks IPs that never signed in to that account, so others
# can't lock you out.
LOGIN_MAX_FAILURES_PER_IP=10
LOGIN_MAX_FAILURES_PER_ACCOUNT=30
LOGIN_LOCKOUT_MINUTES=15

# Look up the latest release on GitHub every few hours and show admins when
# an update is available. Set to false to turn this off.
UPDATE_CHECK=true

# Where Docker container checks ask which containers run. The default is the
# read-only proxy that starts with: docker compose --profile docker up -d
# DOCKER_HOST=http://docker-proxy:2375

# Encrypts the authenticator app secrets for two-factor sign-in. Without it
# only email codes are offered. Make one with: openssl rand -hex 32
# Keep it safe: if it changes, everyone has to set up their app again.
SECRET_KEY=

# Email notifications. Leave SMTP_HOST empty to turn email off. Panel users
# choose on their profile which notifications they get. SMTP_ENCRYPTION is
# tls (port 465), starttls (port 587) or none.
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Defaults to the site name.
SMTP_FROM_NAME=

RUST_LOG=info
